+    private void applySystemTheme(boolean light) {
+        final android.view.Window window = getWindow();
+        final android.view.View decor = window.getDecorView();
+        int flags = decor.getSystemUiVisibility();
+
+        if (light) {
+            window.setStatusBarColor(android.graphics.Color.rgb(248, 251, 255));
+            window.setNavigationBarColor(android.graphics.Color.rgb(248, 251, 255));
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
+                flags |= android.view.View.SYSTEM_UI_FLAG_LIGHT_STATUS_BAR;
+            }
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+                flags |= android.view.View.SYSTEM_UI_FLAG_LIGHT_NAVIGATION_BAR;
+            }
+        } else {
+            window.setStatusBarColor(android.graphics.Color.rgb(6, 19, 38));
+            window.setNavigationBarColor(android.graphics.Color.rgb(6, 23, 45));
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
+                flags &= ~android.view.View.SYSTEM_UI_FLAG_LIGHT_STATUS_BAR;
+            }
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+                flags &= ~android.view.View.SYSTEM_UI_FLAG_LIGHT_NAVIGATION_BAR;
+            }
+        }
+        decor.setSystemUiVisibility(flags);
+    }
