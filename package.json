{
  "name": "vyapar-ai",
  "version": "0.0.0",
  "private": true,
  "description": "Build and verify the shared Vyapar AI frontend. App release identity is in version.json.",
  "scripts": {
    "build": "node tools/build-frontend-bundles.mjs",
    "check": "node tools/build-frontend-bundles.mjs --check && node tools/validate-runtime.mjs",
    "test": "node --test tests/*.test.js",
    "verify": "npm run check && npm test",
    "android:legacy": "node tools/transpile-android-legacy.mjs && node tools/patch-android-native-startup.mjs",
    "preview": "python3 -m http.server 8080 --directory web"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
