name: Build Vyapar AI Android APK - Main

on:
  workflow_dispatch:
  push:
    branches: [main]
    paths:
      - 'android-app/**'
      - 'frontend-source/**'
      - 'tools/**'
      - 'tests/**'
      - 'web/**'
      - 'version.json'
      - 'RELEASE_*.md'
      - '.github/workflows/build-android.yml'

permissions:
  contents: write

concurrency:
  group: vyapar-main-release
  cancel-in-progress: false

jobs:
  build-apk:
    name: Build and Release Android APK from main
    if: github.ref_name == 'main'
    runs-on: ubuntu-latest

    steps:
      - name: Checkout main
        uses: actions/checkout@v4
        with:
          ref: main
          fetch-depth: 0

      - name: Verify APK source branch
        shell: bash
        run: |
          set -euo pipefail
          test "${GITHUB_REF_NAME}" = "main"
          echo "APK source branch: ${GITHUB_REF_NAME}"

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Android SDK
        uses: android-actions/setup-android@v3

      - name: Install Android SDK 34
        run: |
          yes | sdkmanager --licenses >/dev/null || true
          sdkmanager "platform-tools" "platforms;android-34" "build-tools;34.0.0"

      - name: Detect native C++ / JNI configuration
        id: native
        shell: bash
        run: |
          set -euo pipefail
          if [ -f android-app/app/src/main/cpp/CMakeLists.txt ]; then
            echo "kind=cmake" >> "$GITHUB_OUTPUT"
          elif [ -f android-app/app/src/main/jni/Android.mk ]; then
            echo "kind=ndk-build" >> "$GITHUB_OUTPUT"
          elif find android-app/app/src/main -type f \
            \( -name '*.cpp' -o -name '*.cc' -o -name '*.c' -o -name '*.h' -o -name '*.hpp' \) \
            -print -quit | grep -q .; then
            echo "JNI/C++ source exists, but no supported build file was found." >&2
            exit 1
          else
            echo "kind=none" >> "$GITHUB_OUTPUT"
          fi

      - name: Install native toolchain when JNI exists
        if: steps.native.outputs.kind != 'none'
        run: sdkmanager "ndk;26.1.10909125" "cmake;3.22.1"

      - name: Set up Gradle 8.7
        uses: gradle/actions/setup-gradle@v6
        with:
          gradle-version: '8.7'

      - name: Apply native stability patch
        shell: bash
        run: |
          set -euo pipefail
          PATCH=release-patches/mainactivity-851.patch
          if [ ! -f "$PATCH" ]; then
            echo "No native stability patch present; continuing."
          elif git apply --check "$PATCH"; then
            git apply "$PATCH"
          elif git apply --reverse --check "$PATCH"; then
            echo "Native stability patch already applied."
          else
            echo "Native stability patch cannot be applied cleanly." >&2
            exit 1
          fi

      - name: Align runtime release metadata
        shell: bash
        run: |
          set -euo pipefail
          python - <<'PY'
          from pathlib import Path
          import json, re
          version = json.loads(Path('version.json').read_text(encoding='utf-8'))
          VERSION = version['versionName']
          CODE = str(version['versionCode'])
          CACHE = f'{CODE}-uiorganized1'
          for path in [Path('web/index.html'), Path('android-app/app/src/main/assets/index.html')]:
              text = path.read_text(encoding='utf-8')
              text = re.sub(r'<meta name="vyapar-ui-version" content="[^"]+"\s*/>', f'<meta name="vyapar-ui-version" content="{VERSION}" />', text, count=1)
              text = re.sub(r'assets/styles/vyapar-core\.css\?v=[^"]+', f'assets/styles/vyapar-core.css?v={CACHE}', text, count=1)
              text = re.sub(r'assets/styles/vyapar-ui\.css\?v=[^"]+', f'assets/styles/vyapar-ui.css?v={CACHE}', text, count=1)
              text = re.sub(r'assets/scripts/vyapar-app\.js\?v=[^"]+', f'assets/scripts/vyapar-app.js?v={CACHE}',