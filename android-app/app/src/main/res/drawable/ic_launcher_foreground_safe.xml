<?xml version="1.0" encoding="utf-8"?>
<!--
  Android launcher safe-zone wrapper for the supplied storefront artwork.
  The OS applies its own circle/squircle mask to adaptive icons. Keeping the
  foreground at 60dp inside the 108dp adaptive canvas prevents the canopy,
  door and base from being clipped in Package Installer / launcher previews.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="60dp"
        android:height="60dp"
        android:gravity="center"
        android:drawable="@drawable/ic_launcher" />
</layer-list>
