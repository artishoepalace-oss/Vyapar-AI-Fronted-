<?xml version="1.0" encoding="utf-8"?>
<!-- Legacy (API 23–25) circular launcher wrapper. The square source bitmap is
     kept fully inside the circular silhouette so its white corners can never
     protrude beyond the icon mask. API 26+ uses the adaptive override. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item
        android:width="34dp"
        android:height="34dp"
        android:gravity="center">
        <bitmap
            android:src="@drawable/ic_launcher"
            android:gravity="fill"
            android:filter="true" />
    </item>
</layer-list>
