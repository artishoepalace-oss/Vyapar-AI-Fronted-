<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@drawable/launch_screen</item>
        <item name="android:colorBackground">#F8F9FA</item>
        <item name="android:colorAccent">#2457D6</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F8F9FA</item>
        <item name="android:navigationBarColor">#F8F9FA</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowSplashScreenBackground">#F8F9FA</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#F8F9FA</item>
        <item name="android:windowSplashScreenAnimationDuration">180</item>
    </style>
</resources>
